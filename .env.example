# Copy to .env and fill in. NEVER commit .env. Values below are placeholders, not real credentials.
APP_ENV=development

# ---------- MongoDB Atlas ----------
# Atlas > Connect > Drivers. Add your IP under Network Access. Use a database user with readWrite on "videoguard".
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/videoguard?retryWrites=true&w=majority

# ---------- Backend ----------
BACKEND_PORT=8081
FRONTEND_ORIGIN=http://localhost:5173
# >= 32 random characters. Generate: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }) -as [byte[]])
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE_AT_LEAST_32_CHARS
JWT_ACCESS_TOKEN_TTL_MINUTES=15
# Shared secret between backend and AI service (>= 32 chars, different from JWT_SECRET)
AI_SERVICE_TOKEN=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_VALUE
AI_SERVICE_URL=http://localhost:8000
# First administrator, created only if no ADMIN exists (password: 10+ chars, upper, lower, digit). Remove after first start.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeThisPassw0rd

# ---------- Private local storage (shared by backend and AI service; keep OUTSIDE any web root) ----------
VIDEO_STORAGE_ROOT=C:/videoguard-data/videos
EVIDENCE_STORAGE_ROOT=C:/videoguard-data/evidence
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=3600
STORAGE_QUOTA_GB=100
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
WORKER_THREADS=1
JOB_LEASE_SECONDS=120
MAX_JOB_ATTEMPTS=2

# ---------- AI service ----------
OBJECT_DETECTOR=yolov8n
YOLOV8_MODEL_PATH=models/yolov8n.pt
AI_DEVICE=cpu
AI_IMAGE_SIZE=640
AI_SAMPLING_FPS=5
DETECTION_CONFIDENCE=0.25
# Optional weapon checkpoint (see README: licensing + availability must be verified first)
WEAPON_MODEL_ENABLED=false
WEAPON_MODEL_PATH=models/weapon/best.pt
WEAPON_CONFIDENCE=0.30
# Labels of YOUR checkpoint that count as weapons (must exist in its class names, e.g. 'weapon' for a single-class dataset)
WEAPON_LABELS=pistol,knife
# Rule thresholds: calibrate on labeled footage before trusting them
LOITERING_THRESHOLD_SECONDS=8
# Loitering: the person stays within this many BODY HEIGHTS for the time above (distance-independent)
LOITERING_MAX_MOVEMENT=0.75
# Running: sustained speed in body-heights per second (walking is about 0.8, running 3 or more). Not a real-world speed.
RUNNING_SPEED_THRESHOLD=2.2
# People shorter than this fraction of the frame height are ignored by the motion rules (too far away to measure)
MIN_PERSON_HEIGHT=0.05
# Fall detection needs the pose model: python scripts/download_weights.py --pose
POSE_MODEL_ENABLED=false
POSE_MODEL_PATH=models/yolov8n-pose.pt
FALL_UPRIGHT_DEG=35
FALL_LYING_DEG=60
FALL_TRANSITION_SECONDS=2.0
FALL_LYING_SECONDS=2.5
